{
  "manifest_version": 3,
  "name": "LeetCode Themes & Tools",
  "short_name": "LeetCode Themes",
  "version": "1.0.0",
  "description": "Custom aesthetic themes, Monaco editor styles, coding fonts, interview blind mode, timer, and notes for LeetCode.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LeetCode Themes",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "src/scenes.js",
        "src/content.js",
        "src/monaco-theme.js",
        "src/editor-settings.js",
        "src/blind-mode.js",
        "src/timer.js",
        "src/notes.js",
        "src/zen-mode.js",
        "src/command-palette.js",
        "src/day-night.js",
        "src/theme-sync.js"
      ],
      "css": [
        "themes/themes.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-zen": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Toggle distraction-free Zen mode"
    },
    "toggle-focus": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Toggle focus mode (hide custom wallpaper)"
    },
    "toggle-blind": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Toggle interview Blind mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "textures/*",
        "textures/anime/*",
        "textures/game/*",
        "textures/game/icon/*",
        "icons/*"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*"
      ]
    }
  ]
}
