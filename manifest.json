{
  "manifest_version": 3,
  "name": "LeetCode Themes & Tools",
  "short_name": "LeetCode Themes",
  "version": "1.0.0",
  "description": "Custom aesthetic themes, Monaco editor styles, coding fonts, interview blind mode, timer, and notes for LeetCode.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LeetCode Themes",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "src/net-verdict.js",
        "src/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "src/content.js",
        "src/problem.js",
        "src/anime/scenes.js",
        "src/anime/css.js",
        "src/anime/anime.js",
        "src/monaco-ink.js",
        "src/sheet-scroll.js",
        "src/verdict.js",
        "src/share.js",
        "src/anime/moments-ui.js",
        "src/anime/sounds.js",
        "src/anime/moments.js",
        "src/game/petals.js",
        "src/game/sounds.js",
        "src/game/title-card.js",
        "src/game/game.js",
        "src/game/icons.js",
        "src/game/ambient.js",
        "src/game/result.js",
        "src/game/sidebar.js",
        "src/pixel/sprites.js",
        "src/pixel/pixel.js",
        "src/editor-settings.js",
        "src/blind-mode.js",
        "src/timer.js",
        "src/notes.js",
        "src/zen-mode.js",
        "src/command-palette.js",
        "src/day-night.js",
        "src/theme-sync.js"
      ],
      "css": [
        "themes/core.css",
        "themes/paper.css",
        "themes/sakura.css",
        "themes/grid.css",
        "themes/orchid.css",
        "themes/anime.css",
        "themes/crawler.css",
        "themes/game.css",
        "themes/pixel.css",
        "themes/themes.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-zen": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Toggle distraction-free Zen mode"
    },
    "toggle-focus": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Toggle focus mode (hide custom wallpaper)"
    },
    "toggle-blind": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Toggle interview Blind mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "textures/*",
        "textures/anime/*",
        "textures/game/*",
        "textures/game/icon/*",
        "icons/*",
        "src/studio.html",
        "src/anime/*"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*"
      ]
    }
  ]
}
